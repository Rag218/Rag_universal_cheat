--// ESP - COM MÚLTIPLAS LINHAS PARA O TRACER (CORREÇÃO)
local MAX_TRACER_LINES = 30  -- suficiente até espessura 30
local drawings = {}  -- { tracerLines = {}, name, hp, box }

local function getTeamColor(plr)
    if plr.Team and plr.TeamColor then return plr.TeamColor.Color end
    return Color3.new(1,1,1)
end

local function SameTeam(plr)
    if LocalPlayer.Team and plr.Team then return LocalPlayer.Team == plr.Team end
    return false
end

local function getCharacterBounds(char)
    local minX,minY = math.huge,math.huge
    local maxX,maxY = -math.huge,-math.huge
    local found = false
    for _,part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            local pos,visible = Camera:WorldToViewportPoint(part.Position)
            if visible then
                found = true
                local sizeFactor = (part.Size.Magnitude / pos.Z) * 120
                minX = math.min(minX, pos.X - sizeFactor)
                minY = math.min(minY, pos.Y - sizeFactor)
                maxX = math.max(maxX, pos.X + sizeFactor)
                maxY = math.max(maxY, pos.Y + sizeFactor)
            end
        end
    end
    return found and minX,minY,maxX,maxY
end

local function createESP(plr)
    if plr == LocalPlayer then return end
    local tracerLines = {}
    for i = 1, MAX_TRACER_LINES do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 1
        tracerLines[i] = line
    end
    local name = Drawing.new("Text")
    name.Visible = false
    name.Center = true
    name.Outline = true
    name.Size = 16
    local hp = Drawing.new("Text")
    hp.Visible = false
    hp.Center = true
    hp.Outline = true
    hp.Size = 15
    local box = Drawing.new("Square")
    box.Visible = false
    box.Filled = false
    drawings[plr] = {
        Tracer = tracerLines,
        Name = name,
        HP = hp,
        Box = box
    }
end

local function removeESP(plr)
    if drawings[plr] then
        for _,line in pairs(drawings[plr].Tracer) do line:Remove() end
        drawings[plr].Name:Remove()
        drawings[plr].HP:Remove()
        drawings[plr].Box:Remove()
        drawings[plr] = nil
    end
end

for _,plr in pairs(Players:GetPlayers()) do createESP(plr) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

--// AIMBOT
local function isVisible(part,targetChar)
    local origin = Camera.CFrame.Position
    local direction = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = { LocalPlayer.Character, targetChar }
    local hit = workspace:Raycast(origin, direction, params)
    return hit == nil
end

local function getBestTarget()
    local center = Camera.ViewportSize / 2
    local bestDist = math.huge
    local bestHeadPos = nil
    for _,plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local head = plr.Character:FindFirstChild("Head")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and head and root then
                if Config.TeamCheck and SameTeam(plr) then continue end
                local distance = (root.Position - Camera.CFrame.Position).Magnitude
                if distance <= Config.Aimbot_MaxRange then
                    -- Verifica qualquer parte do personagem no FOV
                    local minPartDist = math.huge
                    for _, part in ipairs(plr.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            local pos, visible = Camera:WorldToViewportPoint(part.Position)
                            if visible and pos.Z > 0 then
                                local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(center.X, center.Y)).Magnitude
                                if dist < minPartDist then
                                    minPartDist = dist
                                end
                            end
                        end
                    end
                    if minPartDist <= Config.FOV then
                        -- Se wallcheck ativado, verifica se a cabeça está visível
                        if Config.WallCheck and not isVisible(head, plr.Character) then continue end
                        if minPartDist < bestDist then
                            bestDist = minPartDist
                            bestHeadPos = head.Position
                        end
                    end
                end
            end
        end
    end
    return bestHeadPos
end

--// LOOP PRINCIPAL (LÓGICA DE SMOOTHNESS INVERTIDA)
RunService.RenderStepped:Connect(function()
    -- FOV
    FOVCircle.Visible = Config.ShowFOV
    FOVCircle.Size = UDim2.new(0, Config.FOV * 2, 0, Config.FOV * 2)
    FOVCircle.Position = UDim2.new(0.5, -Config.FOV, 0.5, -Config.FOV)

    -- ESP
    for plr, esp in pairs(drawings) do
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        if char and hum and hum.Health > 0 and root and head then
            local distance = (root.Position - Camera.CFrame.Position).Magnitude
            if distance <= Config.ESP_MaxRange then
                local pos, visible = Camera:WorldToViewportPoint(root.Position)
                if visible and pos.Z > 0 then
                    local color = getTeamColor(plr)

                    -- TRACER COM MÚLTIPLAS LINHAS
                    if Config.ESP_Line then
                        local startVec = Vector2.new(Camera.ViewportSize.X / 2, 0)
                        local endVec = Vector2.new(pos.X, pos.Y)
                        local dir = (endVec - startVec).Unit
                        local perp = Vector2.new(-dir.Y, dir.X)
                        local thickness = Config.TracerThickness
                        local lineCount = math.max(1, math.ceil(thickness))
                        lineCount = math.min(lineCount, MAX_TRACER_LINES)
                        local half = (lineCount - 1) / 2
                        for i = 1, MAX_TRACER_LINES do
                            local line = esp.Tracer[i]
                            if i <= lineCount then
                                local offset = (i - 1) - half
                                local shift = perp * offset
                                line.From = startVec + shift
                                line.To = endVec + shift
                                line.Color = color
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        end
                    else
                        for _, line in ipairs(esp.Tracer) do line.Visible = false end
                    end

                    -- NAME
                    if Config.ESP_Name then
                        esp.Name.Visible = true
                        esp.Name.Text = plr.Name
                        esp.Name.Color = color
                        esp.Name.Position = Vector2.new(pos.X, pos.Y - 35)
                    else
                        esp.Name.Visible = false
                    end

                    -- HP
                    if Config.ESP_HP then
                        esp.HP.Visible = true
                        esp.HP.Text = "HP: "..math.floor(hum.Health)
                        esp.HP.Color = color
                        esp.HP.Position = Vector2.new(pos.X, pos.Y + 25)
                    else
                        esp.HP.Visible = false
                    end

                    -- BOX
                    local minX,minY,maxX,maxY = getCharacterBounds(char)
                    if minX and Config.ESP_Box then
                        esp.Box.Visible = true
                        esp.Box.Color = color
                        esp.Box.Thickness = Config.BoxThickness
                        esp.Box.Size = Vector2.new(maxX - minX, maxY - minY)
                        esp.Box.Position = Vector2.new(minX, minY)
                    else
                        esp.Box.Visible = false
                    end
                else
                    for _, line in ipairs(esp.Tracer) do line.Visible = false end
                    esp.Name.Visible = false
                    esp.HP.Visible = false
                    esp.Box.Visible = false
                end
            else
                for _, line in ipairs(esp.Tracer) do line.Visible = false end
                esp.Name.Visible = false
                esp.HP.Visible = false
                esp.Box.Visible = false
            end
        else
            for _, line in ipairs(esp.Tracer) do line.Visible = false end
            esp.Name.Visible = false
            esp.HP.Visible = false
            esp.Box.Visible = false
        end
    end

    -- AIMBOT (SMOOTHNESS INVERTIDA: 0 = instantâneo, 1 = suave)
    if Config.Aimbot then
        local targetPos = getBestTarget()
        if targetPos then
            FOVStroke.Color = Color3.fromRGB(0,255,0)
            local targetCF = CFrame.new(Camera.CFrame.Position, targetPos)
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, 1 - Config.Smoothness)
        else
            FOVStroke.Color = Color3.fromRGB(255,0,0)
        end
    else
        FOVStroke.Color = Color3.fromRGB(255,0,0)
    end
end)
