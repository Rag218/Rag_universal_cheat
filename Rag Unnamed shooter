    local valLabel = Instance.new("TextLabel", valueFrame)
    valLabel.Text = tostring(default)
    valLabel.Font = Enum.Font.GothamBold
    valLabel.TextColor3 = Color3.new(1,1,1)
    valLabel.TextSize = 14
    valLabel.Size = UDim2.new(1,-60,1,0)
    valLabel.Position = UDim2.new(0,30,0,0)
    valLabel.BackgroundTransparency = 1

    local plus = Instance.new("TextButton", valueFrame)
    plus.Text = "+"
    plus.Font = Enum.Font.GothamBold
    plus.TextColor3 = Color3.new(1,1,1)
    plus.TextSize = 16
    plus.Size = UDim2.new(0,30,1,0)
    plus.Position = UDim2.new(1,-30,0,0)
    plus.BackgroundColor3 = Color3.fromRGB(70,70,70)

    local current = default
    local function update()
        valLabel.Text = tostring(current)
        callback(current)
    end
    minus.MouseButton1Click:Connect(function()
        current = math.max(min, current - step)
        update()
    end)
    plus.MouseButton1Click:Connect(function()
        current = math.min(max, current + step)
        update()
    end)
    update()
end

