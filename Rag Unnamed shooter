    local valueFrame = Instance.new("Frame", frame)
    valueFrame.Size = UDim2.new(1,0,0,20)
    valueFrame.Position = UDim2.new(0,0,0,20)
    valueFrame.BackgroundTransparency = 1

    local minus = Instance.new("TextButton", valueFrame)
