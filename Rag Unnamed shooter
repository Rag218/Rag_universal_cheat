-- ========== ESP: CRIAÇÃO / REMOÇÃO ==========
local MAX_TRACER_LINES = 20  -- máximo de linhas por jogador

local function createTopESP(plr)
    if plr == LocalPlayer then return end
    local tracerLines = {}
    for i=1, MAX_TRACER_LINES do
        local line = Drawing.new("Line")
        line.Thickness = 1  -- cada linha individual é fina, o conjunto dá a espessura
        line.Transparency = 1
        line.Visible = false
        tracerLines[i] = line
    end

    local name = Drawing.new("Text")
    name.Size = 16
    name.Center = true
    name.Outline = true
    name.Font = 2

    local hp = Drawing.new("Text")
    hp.Size = 15
    hp.Center = true
    hp.Outline = true
    hp.Font = 2

    drawings[plr] = {tracer = tracerLines, name = name, hp = hp}
end

local function removeTopESP(plr)
    if drawings[plr] then
        local esp = drawings[plr]
        for _, line in ipairs(esp.tracer) do line:Remove() end
        esp.name:Remove()
        esp.hp:Remove()
        drawings[plr] = nil
    end
end

local function createBox(plr)
    if plr == LocalPlayer then return end
    local box = Drawing.new("Square")
    box.Thickness = Config.BoxThickness
    box.Filled = false
    box.Visible = false
    boxes[plr] = box
end

local function removeBox(plr)
    if boxes[plr] then
        boxes[plr]:Remove()
        boxes[plr] = nil
    end
end

