-- ========== LOOP PRINCIPAL ==========
RunService.RenderStepped:Connect(function()
    -- TOP ESP (Tracer, Name, HP)
    for plr, esp in pairs(drawings) do
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        local head = char and char:FindFirstChild("Head")

        if char and hum and root and head and hum.Health > 0 then
            local pos, visible = Camera:WorldToViewportPoint(root.Position)
            local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.6,0))
            local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))

            if visible and pos.Z > 0 then
                local color = getTeamColor(plr)
                local height = math.abs(headPos.Y - legPos.Y)

                -- Tracer (múltiplas linhas)
                if Config.ESP_Line then
                    local startVec = Vector2.new(Camera.ViewportSize.X/2, 0)
                    local endVec = Vector2.new(pos.X, pos.Y)
                    local dir = (endVec - startVec).Unit
                    local perp = Vector2.new(-dir.Y, dir.X)  -- perpendicular
                    local thickness = Config.TracerThickness
                    local half = (thickness - 1) / 2

                    -- Ativar/atualizar cada linha individual
                    for i = 1, MAX_TRACER_LINES do
                        local line = esp.tracer[i]
                        if i <= thickness then
                            local offset = i - 1 - half  -- distribuição simétrica
                            local shift = perp * offset
                            line.From = startVec + shift
                            line.To = endVec + shift
                            line.Color = color
                            line.Visible = true
                        else
                            line.Visible = false
                        end
                    end
                else
                    for _, line in ipairs(esp.tracer) do
                        line.Visible = false
                    end
                end

                -- Nome
                if Config.ESP_Name then
                    esp.name.Visible = true
                    esp.name.Color = color
                    esp.name.Text = plr.Name
                    esp.name.Position = Vector2.new(pos.X, pos.Y - height/2 - 16)
                else
                    esp.name.Visible = false
                end

                -- HP
                if Config.ESP_HP then
                    esp.hp.Visible = true
                    esp.hp.Color = color
                    esp.hp.Text = "HP: "..math.floor(hum.Health)
                    esp.hp.Position = Vector2.new(pos.X, pos.Y + height/2 + 2)
                else
                    esp.hp.Visible = false
                end
            else
                for _, line in ipairs(esp.tracer) do line.Visible = false end
                esp.name.Visible = false
                esp.hp.Visible = false
            end
        else
            for _, line in ipairs(esp.tracer) do line.Visible = false end
            esp.name.Visible = false
            esp.hp.Visible = false
        end
    end

    -- CAIXA 2D (Box)
    for plr, box in pairs(boxes) do
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if char and hum and hum.Health > 0 then
            local minX, minY, maxX, maxY = getCharacterBounds(char)
            if minX and Config.ESP_Box then
                box.Visible = true
                box.Position = Vector2.new(minX, minY)
                box.Size = Vector2.new(maxX - minX, maxY - minY)
                box.Color = getTeamColor(plr)
                box.Thickness = Config.BoxThickness
            else
                box.Visible = false
            end
        else
            box.Visible = false
        end
    end
end)

-- ========== AIMBOT ==========
local function GetClosest()
    local closest = nil
    local shortest = Config.FOV
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                if Config.TeamCheck and SameTeam(plr) then continue end
                local head = char.Head
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist <= shortest then
                        if Config.WallCheck then
                            if Visible(head, char) then
                                shortest = dist
                                closest = head
                            end
                        else
                            shortest = dist
                            closest = head
                        end
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    local target = GetClosest()
    if Config.Aimbot_Enabled and target then
        circleStroke.Color = Color3.fromRGB(0,255,0)
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
    else
        circleStroke.Color = Config.Aimbot_Enabled and Color3.fromRGB(255,0,0) or Color3.fromRGB(100,100,100)
    end
end)